function focusInput(id) {
    var el = document.getElementById(id);
    if (el) {
        el.focus();
    }
}

function focusInputWithClass(selector) {
    var inputField = document.querySelector(selector);
    if (inputField) {
        inputField.focus();
    }
}

function focusInputWithoutScrollWithClass(selector) {
    var inputField = document.querySelector(selector);
    if (inputField) {
        inputField.focus({ preventScroll: true });
    }
}

function selectInputWithClass(selector) {
    var inputField = document.querySelector(selector);
    if (inputField) {
        inputField.select();
    }
}

function blurInput(id) {
    var el = document.getElementById(id);
    if (el) {
        el.blur();
    }
}

function getElementPosition(id) {
    var elem = document.getElementById(id);
    if (elem) {
        var rect = elem.getBoundingClientRect();
        return rect.left + "|" + rect.top + "|" + rect.right + "|" + rect.bottom;
    }
    return "";
}

function ensureShopifyAppBridge(apiKey) {
    if (!apiKey) {
        return;
    }

    var existingMeta = document.querySelector("meta[name='shopify-api-key']");
    if (existingMeta) {
        existingMeta.setAttribute('content', apiKey);
    } else {
        var meta = document.createElement('meta');
        meta.setAttribute('name', 'shopify-api-key');
        meta.setAttribute('content', apiKey);
        document.head.appendChild(meta);
    }

    var existingScript = document.querySelector("script[src='https://cdn.shopify.com/shopifycloud/app-bridge.js']");
    if (existingScript) {
        return;
    }

    var script = document.createElement('script');
    script.src = 'https://cdn.shopify.com/shopifycloud/app-bridge.js';
    script.async = true;
    document.head.appendChild(script);
}

function loadChat() {
    var tag = document.createElement('script');
    tag.src = 'https://www.chatbase.co/embed.min.js';
    tag.id = 'FAgMywXKoSM5OafkoMf8-';
    tag.type = "text/javascript";

    tag.onload = function () {
        console.log("Script loaded successfully");
    }

    tag.onerror = function () {
        console.error("Failed to load script");
    }

    document.body.appendChild(tag);
}


