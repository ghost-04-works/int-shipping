function closeAllEllipsisOpenPackages() {
    var allPackages = document.querySelectorAll(".order-packages-right-aligned-button.open");

    for (var i = 0; i < allPackages.length; i++) {
        var package = allPackages[i];
        if (package) {
            package.classList.remove("open");
        }
    }
}

function manageEllipsisOpenPackages(id) {
    setTimeout(function () {
        closeAllEllipsisOpenPackages();

        var el = document.getElementById(id);
        if (!el) {
            return;
        }

        el.classList.add("open");

        document.onclick = function () {
            closeAllEllipsisOpenPackages();
            document.onclick = null;
        }
    }, 200);
}

function closeEllipsisOpenPackages(id) {
    var el = document.getElementById(id);
    if (!el) {
        return;
    }

    el.classList.remove("open");
}

function setFavicon(url) {
    var link = document.querySelector("link[rel~='icon']");
    if (!link) {
        link = document.createElement('link');
        link.rel = 'icon';
        document.head.appendChild(link);
    }
    link.href = url;
}

function saveFile(fileName, fileContent) {
    var link = document.createElement('a');
    link.download = fileName;
    link.href = "data:text/plain;charset=utf-8," + encodeURIComponent(fileContent)
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

function selectText(element) {
    var doc = document
        , text = doc.getElementById(element)
        , range, selection
        ;
    if (doc.body.createTextRange) { //ms
        range = doc.body.createTextRange();
        range.moveToElementText(text);
        range.select();
    } else if (window.getSelection) { //all others
        selection = window.getSelection();
        range = doc.createRange();
        range.selectNodeContents(text);
        selection.removeAllRanges();
        selection.addRange(range);
    }
}

function playSound(soundUrl) {
    var audio = new Audio(soundUrl);
    audio.addEventListener('canplaythrough', function() { audio.play(); });
}

