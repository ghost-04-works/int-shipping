function initializeIntercom(scriptContent) {
    if (!scriptContent || typeof document === "undefined") {
        return;
    }

    if (window.ssiIntercomLoaded) {
        return;
    }

    const wrapper = document.createElement("div");
    wrapper.innerHTML = scriptContent;

    const scripts = wrapper.querySelectorAll("script");
    scripts.forEach((srcNode) => {
        const script = document.createElement("script");
        if (srcNode.src) {
            script.src = srcNode.src;
        }
        if (srcNode.async) {
            script.async = true;
        }
        if (srcNode.textContent) {
            script.textContent = srcNode.textContent;
        }
        document.body.appendChild(script);
    });

    window.ssiIntercomLoaded = true;
}

function openWmsSupportAssistant(supportUrl) {
    if (!supportUrl) {
        return;
    }
    const assistant = window.aimdoc || window.Agent;
    if (assistant && typeof assistant.openChat === 'function') {
        assistant.openChat({ agentId: 'fe3eaf1f-03c3-4d97-bf29-9ed962d008c2' });
        return;
    }
    if (document.querySelector('aimdoc-widget, #ai-assistant')) {
        window.postMessage({ type: 'aimdoc:openChat', agentId: 'fe3eaf1f-03c3-4d97-bf29-9ed962d008c2' }, '*');
        return;
    }
    window.open(supportUrl, '_blank', 'noopener,noreferrer');
}
