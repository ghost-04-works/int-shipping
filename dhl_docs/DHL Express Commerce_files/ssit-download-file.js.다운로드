function postMessageToHost(msg) {
    if (!window?.webkit?.messageHandlers?.native) {
        return;
    }
    window.webkit.messageHandlers.native.postMessage(msg);
}


function BlazorDownloadFile(content, name, contentType) {
    var msg = `BlazorDownloadFile: ${name}`;

    // Create a URL
    const file = new File([content], name, { type: contentType });
    const exportUrl = URL.createObjectURL(file);
    const encodedName = encodeURIComponent(name);
    msg = "FileName=" + encodedName + "&Uri=" + exportUrl;
    postMessageToHost(msg);

    // Create an <a> element and click on it
    const a = document.createElement("a");
    document.body.appendChild(a);
    a.href = exportUrl;
    a.download = name;
    a.target = "_self";
    a.click();

    if (window && window.webkit && window.webkit.messageHandlers) {
        // webkit will handle revokeObjectURL
        console.log("window.webkit.messageHandlers found");
    } else if (window && window.chrome && window.chrome.webview) {
        // webview will handle revokeObjectURL
       // console.log("window.chrome.webview found");
    }
    else {
        // We don't need to keep the url, so release the memory
        URL.revokeObjectURL(exportUrl);
    }
}


function BlazorDownloadPdf(pdfFileName) {
    const a = document.createElement("a");
    document.body.appendChild(a);
    a.href = pdfFileName;
    a.download = "label";
    a.target = "_self";
    a.click();
}

